{
  "name": "creative-ai-realtime-chat",
  "version": "0.3.0",
  "private": true,
  "description": "P11 local text chat adapted from the preserved Socket.IO exercise",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test --test-concurrency=2 tests/*.test.cjs",
    "test:protocol": "node --test tests/protocol.test.cjs",
    "test:browser": "node --test tests/browser.test.cjs tests/reading.test.cjs",
    "test:reading": "node --test tests/reading.test.cjs",
    "rooms": "node rooms-server.cjs",
    "test:rooms": "node --test tests/rooms.test.cjs tests/rooms-browser.test.cjs",
    "rooms:backup": "node rooms-backup.cjs backup",
    "rooms:inspect": "node rooms-backup.cjs inspect",
    "rooms:restore": "node rooms-backup.cjs restore",
    "test:recovery": "node --test tests/backup.test.cjs tests/recovery-browser.test.cjs"
  },
  "dependencies": {
    "express": "4.22.3",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "playwright-core": "1.64.0",
    "socket.io-client": "4.8.4"
  }
}
