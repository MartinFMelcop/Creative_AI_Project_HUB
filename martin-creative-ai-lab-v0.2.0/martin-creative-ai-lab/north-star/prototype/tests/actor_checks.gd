extends RefCounted
const Combat = preload("res://combat.gd")
const Actors = preload("res://actors.gd")
const ControlsChecks = preload("res://tests/controls_checks.gd")
const Trial = preload("res://tests/rehearsal_checks.gd")

static func run(checker) -> Dictionary:
	var g=Combat.new();g.reset("Guardian")
	var actors=Actors.new();actors.observe(g)
	var samples := {}
	checker.check(actors.pose(g)=="idle","New consumer has no historical gesture")
	var before: Dictionary=g.snapshot()
	actors.observe(g);actors.snapshot(g)
	checker.check(g.snapshot()==before,"Presentation observation cannot change combat")
	g.step(1.0/60.0,{"move":Vector2.RIGHT});actors.observe(g)
	checker.check(actors.pose(g)=="walk" and actors.stride>0,"Actual displacement drives gait")
	var stride: float=actors.stride
	actors.observe(g)
	checker.check(actors.stride==stride,"Repeated redraw/observation never advances gait")
	g.step(1.0/60.0,{});actors.observe(g)
	checker.check(actors.pose(g)=="idle","Stationary character plants its feet")
	g.step(1.0/60.0,{"skill":true});actors.observe(g)
	checker.check(actors.pose(g)=="guard_startup","Shield startup has its own real-state pose")
	for i in 4:g.step(1.0/60.0,{"skill":true});actors.observe(g)
	checker.check(actors.pose(g)=="guard_live","Shield deploys only with a live guard")
	g.phase="bolt";g.target=g.courier;g.clock=0.99
	g.step(1.0/60.0,{"skill":true});actors.observe(g)
	checker.check(actors.contact=="protected" and actors.contact_left>0,"Actual block owns local contact mark")
	samples.block=actors.snapshot(g)
	g.mode="paused";var frozen: Dictionary=actors.snapshot(g)
	for i in 30:g.step(.05,{});actors.observe(g)
	checker.check(actors.snapshot(g)==frozen,"Pause freezes gesture and contact clocks")
	g.mode="play";g.player=Combat.ENEMY+Vector2(-100,0)
	g.step(1.0/60.0,{"strike":true});actors.observe(g)
	checker.check(actors.pose(g)=="counter" and actors.contact=="counter" and actors.sentinel_left>0,"Accepted counter animates blade and sentinel recoil")
	checker.check(actors.action_dir.is_equal_approx((Combat.ENEMY-g.player).normalized()),"Confirmed counter gesture points at the actual contacted target")
	samples.counter=actors.snapshot(g)
	for i in 30:g.step(1.0/60.0,{});actors.observe(g)
	checker.check(actors.action_left==0 and actors.contact_left==0 and actors.sentinel_left==0,"Contact and recovery expire by simulated time")
	g.step(1.0/60.0,{"strike":true});actors.observe(g)
	checker.check(actors.pose(g)=="blade" and actors.contact_left==0 and actors.sentinel_left==0,"An accepted armor strike has a gesture without counterfeit contact")
	g.step(1.0/60.0,{"strike":true});actors.observe(g)
	checker.check(actors.action_left<0.32,"Rejected repeated strike cannot restart the gesture")
	g.reset("Guardian","Riposte");actors.observe(g)
	checker.check(actors.pose(g)=="idle" and actors.contact_left==0,"Same-model reset clears obsolete effects")
	for i in 30:g.step(1.0/60.0,{"skill":true});actors.observe(g)
	checker.check(actors.pose(g)=="guard_stale","Expired Riposte visibly differs from live defense")
	g.phase="bolt";g.target=g.courier;g.clock=0.99
	g.step(1.0/60.0,{"skill":true});actors.observe(g)
	checker.check(actors.hurt_left>0 and actors.contact=="bolt_hit","Expired shield cannot receive block feedback")
	samples.stale=actors.snapshot(g)
	var replacement=Combat.new();replacement.reset("Duelist");replacement.phase="bolt";replacement.target=replacement.courier
	actors.observe(replacement);replacement.step(1.0/60.0,{"skill_pressed":true});actors.observe(replacement)
	checker.check(actors.pose(replacement)=="draw" and actors.contact_left==0,"Accepted draw has an open-blade gesture without claimed impact")
	samples.draw=actors.snapshot(replacement)
	replacement.step(1.0/60.0,{"move":Vector2.UP,"dodge":true});actors.observe(replacement)
	checker.check(actors.pose(replacement)=="step","Paid step overrides previous draw pose")
	samples.step=actors.snapshot(replacement)
	var another=Actors.new();another.observe(replacement)
	checker.check(another.action_left==0 and another.contact_left==0,"Attaching to an advanced model does not replay old events")
	replacement.step_left=0;replacement.phase="bolt";replacement.target=replacement.courier;replacement.player.y=600;replacement.clock=.99
	replacement.step(1.0/60.0,{});actors.observe(replacement)
	checker.check(actors.courier_hurt_left>0 and actors.hurt_left==0,"Courier damage belongs to the courier, not the player")
	before=replacement.snapshot();another.attach(replacement)
	checker.check(replacement.snapshot()==before and another.contact_left==0,"Observer replacement clears effects without restoring combat")
	var west=Combat.new();west.reset("Guardian");west.player=Vector2(900,390);west.courier=Vector2(1000,390);west.target=west.courier;west.phase="bolt";west.guard=true;west.guard_age=.1;west.locked_face=Vector2.LEFT
	actors.attach(west);west.resolve_threat();actors.observe(west)
	checker.check(west.counters.blocks==1 and absf(absf(actors.contact_angle)-PI)<.001,"A real west-facing block places feedback on the incoming side")
	var scene=ControlsChecks.scene(checker,"actors")
	Trial.key(scene,KEY_ENTER);scene._physics_process(1.0/60.0)
	checker.check(scene.actors.model==scene.game,"Actual consumer attaches its presentation observer")
	scene.game.phase="bolt";scene.game.clock=.99;scene.game.target=scene.game.courier
	ControlsChecks.physical(KEY_K)
	for i in 6:scene._physics_process(1.0/60.0)
	ControlsChecks.physical(KEY_K,false)
	checker.check(scene.actors.contact=="bolt_hit" and scene.game.counters.blocks==0,"Actual input startup failure retains damage visual ownership")
	Trial.key(scene,KEY_ESCAPE);var paused: Dictionary=scene.actors.snapshot(scene.game)
	for i in 10:scene._physics_process(.05)
	checker.check(scene.actors.snapshot(scene.game)==paused,"Actual paused consumer cannot age its effects")
	Trial.key(scene,KEY_R)
	checker.check(scene.actors.model==scene.game and scene.actors.contact_left==0,"Actual abandonment clears effects for selection")
	Trial.key(scene,KEY_2);Trial.key(scene,KEY_T)
	checker.check(scene.actors.model==scene.game and scene.actors.action_left==0,"Rehearsal replacement does not import crossing effects")
	scene.queue_free()
	return samples
